<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="BCRYPT_ROUNDS" value="4"/>

        <!--
            A DEDICATED database, and deliberately not the one .env names.

            RefreshDatabase runs migrate:fresh, which DROPS every table before the
            suite starts. While this read budget_v2_testing, the same name .env
            holds, that made the test suite destroy the development fixtures on
            every run, so the seeded data was gone by the time anyone looked at it
            and every run had to be followed by three db:seed commands. The two must
            differ, and .env is the one that gets repointed, so the test name belongs
            here where it is committed rather than in .env.testing, which is ignored.

            The name has to carry a test marker: Database\Seeders\Concerns\
            GuardsAgainstNonTestDatabase refuses to write fixtures into a database
            whose name looks live, and the seeder tests run the seeder. That is the
            guard doing its job, and it is why "budget_v2_test" rather than
            "budget_v2_phpunit", which would read as live and be refused.

            This database is disposable by design. Nothing in it survives a run.

            DB_USERNAME / DB_PASSWORD are inherited from .env.

            PREFERRED (once "sudo apt install php8.3-sqlite3" is available):
            replace the two MySQL lines below with

                <env name="DB_CONNECTION" value="sqlite"/>
                <env name="DB_DATABASE" value=":memory:"/>
        -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="budget_v2_test"/>

        <!--
            CACHE_STORE is the Laravel 11+ name. The pre-L11 CACHE_DRIVER alias
            was removed from this file when the framework was upgraded.
        -->
        <env name="CACHE_STORE" value="array"/>

        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
